{% comment %} Based off of the video include {% endcomment %}

{% capture audio_id %}{{ include.id }}{% endcapture %}
{% capture audio_provider %}{{ include.provider }}{% endcapture %}

{% capture audio_src %}
  {% case audio_provider %}
    {% when "archive_org" %}
      https://archive.org/embed/{{ audio_id }}
    {% when "rss_com" %}
      https://player.rss.com/bible-by-example/{{ audio_id }}
  {% endcase %}
{% endcapture %}
{% assign audio_src = audio_src | strip %}

{% capture audio_title %}
  {% if include.title %}
    {{ include.title }}
  {% else %}
      {% case audio_provider %}
      {% when "archive_org" %}
        Archive.org audio player
      {% when "rss_com" %}
        RSS.com audio player
      {% else %}
        Audio player
    {% endcase %}
  {% endif %}
{% endcapture %}
{% assign audio_title = audio_title | strip %}

<!-- Courtesy of embedresponsively.com -->
{% unless audio_src == "" %}
  <div class="responsive-video-container">
    <iframe src="{{ audio_src }}" title="{{ audio_title }}" frameborder="0" webkitAllowFullScreen mozallowfullscreen allowfullscreen></iframe>
  </div>
{% endunless %}

{% comment %}
  RSS.com Latest Show Example:
    <iframe src="https://player.rss.com/bible-by-example/latest?theme=light&v=2" title="Bible By Example" width="100%" height="202px" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen scrolling="no"><a href="https://rss.com/podcasts/bible-by-example/latest/">Bible By Example | RSS.com</a></iframe>

  RSS.com Specific Episode Example:
    <iframe src="https://player.rss.com/bible-by-example/000000" title="Episode Title" width="100%" height="202px" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen scrolling="no"><a href="https://rss.com/podcasts/bible-by-example/000000">Episode Title</a></iframe>

  Archive.org Specific File Example:
    <iframe src="https://archive.org/embed/teachingandteachers_2605_librivox/teachingandteachers_02_trumbull_128kb.mp3" width="500" height="30" frameborder="0" webkitallowfullscreen="true" mozallowfullscreen="true" allowfullscreen=""></iframe>
{% endcomment %}
